diff --git a/crypto/fscrypttwrp/fscrypttwrp.cpp b/crypto/fscrypttwrp/fscrypttwrp.cpp
new file mode 100644
index 0000000..8635f52
--- /dev/null
+++ b/crypto/fscrypttwrp/fscrypttwrp.cpp
@@ -0,0 +1,47 @@
+/*
+ * Stub implementation of libfscrypttwrp for PBRP android-14.0 on Android 16 build tree.
+ * The real implementation lives in PBRP's system/vold fork, which is not available here.
+ * FBE backup/restore via libtar will degrade gracefully (logs an error, skips fscrypt policy).
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <linux/fscrypt.h>
+
+extern "C" {
+
+bool fscrypt_set_mode() {
+    return false;
+}
+
+/* V2 is the default (NX779J does not set TW_USE_FSCRYPT_POLICY := 1) */
+bool lookup_ref_key(struct fscrypt_policy_v2 *fep, uint8_t *policy_type) {
+    (void)fep; (void)policy_type;
+    return false;
+}
+
+bool lookup_ref_tar(struct fscrypt_policy_v2 *fep, uint8_t *policy) {
+    (void)fep; (void)policy;
+    return false;
+}
+
+bool fscrypt_policy_get_struct(const char *directory, struct fscrypt_policy_v2 *fep) {
+    (void)directory; (void)fep;
+    return false;
+}
+
+bool fscrypt_policy_set_struct(const char *directory, const struct fscrypt_policy_v2 *fep) {
+    (void)directory; (void)fep;
+    return false;
+}
+
+void bytes_to_hex(const uint8_t *bytes, size_t num_bytes, char *hex) {
+    static const char h[] = "0123456789abcdef";
+    for (size_t i = 0; i < num_bytes; i++) {
+        hex[2 * i]     = h[(bytes[i] >> 4) & 0xF];
+        hex[2 * i + 1] = h[bytes[i] & 0xF];
+    }
+    hex[2 * num_bytes] = '\0';
+}
+
+} /* extern "C" */
